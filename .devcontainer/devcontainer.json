{
  "name": "autoresearch-container",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ""
  },
  // 1. GPU CONFIGURATION
  "runArgs": [
    "--name=autoresearch-container",
    // "--gpus", "device=6",     // Uncomment on host with NVIDIA + that GPU index
    "--cap-drop=ALL",
    "--security-opt",
    "no-new-privileges:true",
    "--pids-limit",
    "512",
    "--shm-size=8g", // Prevent PyTorch DataLoader crashes
    "--ulimit",
    "memlock=-1", // optimize memory locking for CUDA
    "--cpus",
    "4" // 4 cores
  ],
  // 1.1. ENVIRONMENT VARIABLES
  "containerEnv": {
    "HIGH_RISK": "false"
  },
  "remoteEnv": {
    "HIGH_RISK": "false"
  },
  // 2. DATA MOUNTING
  "mounts": [
    // MOUNT 1: Codebase (Implicitly handled by VS Code, but good to be explicit)
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
    // MOUNT 2: Data (READ-ONLY for safety)
    // UPDATE THIS PATH ↓
    // "source=/mnt/raid0/bb2238/autoresearch,target=/data/,type=bind,consistency=cached,readonly"
  ],
  "workspaceFolder": "/workspace",
  // 3. VS CODE CUSTOMIZATIONS
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter", // Jupyter support - allows us to run jupyter notebooks in the container
        "ms-python.vscode-docker",
        "ms-python.black-formatter", // Auto-formatter
        "njpwerner.autodocstring", // Docstring generator
        "nvidia.nsight-vscode-edition",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.formatting.provider": "black" // auto-formatter for python code using black package
      }
    }
  },
  // permission fix to avoid files being created as root
  "remoteUser": "bb2238",
  // below forces the container user (dev) to adopt my Host UID
  "updateRemoteUser": true,
  "postCreateCommand": "bash -lc 'bash /workspace/.devcontainer/setup.sh'",
  "postStartCommand": "bash -lc 'if [ -f /workspace/.env ]; then echo \"Found /workspace/.env; not sourcing automatically for safety.\"; fi'"
}